# Variables del servidor para /api/chat (Vercel → Settings → Environment Variables).
# Ninguna lleva prefijo VITE_: así nunca se incrustan en el JavaScript público.

# Webhook web del agente en Visione Flow. Tratar la URL como secreto: hoy el canal
# no exige autenticación, así que quien la conozca puede llamarlo.
CHATBOT_API_URL=
# Opcional: solo si el webhook exige el header X-API-Key
CHATBOT_API_KEY=

# Upstash Redis para el rate-limit (la integración de Vercel las crea sola;
# también se aceptan KV_REST_API_URL y KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sal para el hash de las IPs (cualquier texto aleatorio largo)
RATE_LIMIT_SALT=
